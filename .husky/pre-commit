#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh" 2>/dev/null || true

# rtbk-claude-design-flow pre-commit hook
# 워크플로우 산출물 구조에 대한 가벼운 점검(경고만)을 수행합니다. 커밋을 막지는 않습니다.

echo "[pre-commit] rtbk-claude-design-flow 점검 시작"

# 필수 디렉토리 존재 확인 (경고만)
for dir in data/00-inputs data/01-analysis data/02-design-system data/03-screens data/04-brief data/05-candidates data/06-code data/07-review; do
  if [ ! -d "$dir" ]; then
    echo "[pre-commit] 경고: 디렉토리 누락 -> $dir"
  fi
done

echo "[pre-commit] 점검 완료"
exit 0
